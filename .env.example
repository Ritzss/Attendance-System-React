# Required for signing admin session cookies.
JWT_SECRET=replace-with-a-long-random-secret

# Optional fallback admin account for local development / first login.
# Prefer ADMIN_PASSWORD_HASH over ADMIN_PASSWORD in production.
ADMIN_ID=local-admin
ADMIN_NAME=Local Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# ADMIN_PASSWORD_HASH=

# Optional Nodemailer SMTP configuration for employee credential emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Attendance Admin <no-reply@example.com>"
