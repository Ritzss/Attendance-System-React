# Local admin panel configuration
# Change these values before deploying to production.
JWT_SECRET=change-this-local-development-secret
ADMIN_ID=local-admin
ADMIN_NAME=Local Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Optional: use ADMIN_PASSWORD_HASH instead of ADMIN_PASSWORD for production-like local testing.
# ADMIN_PASSWORD_HASH=

# Optional Nodemailer SMTP configuration for employee credential emails.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Attendance Admin <no-reply@example.com>"
